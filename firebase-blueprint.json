{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user information and progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier for the user." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "grade": { "type": "string", "enum": ["Grade 8", "Grade 9", "Grade 10", "Grade 11", "Grade 12"], "description": "The student's grade level." },
        "totalPoints": { "type": "integer", "description": "Total points earned by the user." },
        "completedQuizzes": { "type": "array", "items": { "type": "string" }, "description": "List of quiz IDs completed by the user." },
        "streak": { "type": "integer", "description": "Current daily login streak." },
        "lastActive": { "type": "string", "format": "date-time", "description": "Last activity timestamp." },
        "badges": { "type": "array", "items": { "type": "string" }, "description": "List of earned badges." }
      },
      "required": ["uid", "displayName", "email", "grade"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Represents an educational quiz.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "grade": { "type": "string" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctOption": { "type": "integer" },
              "explanation": { "type": "string" }
            }
          }
        },
        "createdBy": { "type": "string", "description": "UID of the user who created the quiz." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "grade", "questions", "createdBy"]
    },
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "A denormalized entry for the leaderboard.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "score": { "type": "integer" },
        "grade": { "type": "string" }
      },
      "required": ["uid", "displayName", "score", "grade"]
    },
    "StudyGroup": {
      "title": "Study Group",
      "description": "A group for students to collaborate.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "grade": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "grade", "members", "createdBy"]
    },
    "Message": {
      "title": "Message",
      "description": "A message in a study group discussion.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "senderId", "senderName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Collection of educational quizzes."
    },
    "/leaderboards/{grade}/entries/{userId}": {
      "schema": "LeaderboardEntry",
      "description": "Grade-specific leaderboard entries."
    },
    "/studyGroups/{groupId}": {
      "schema": "StudyGroup",
      "description": "Collection of study groups."
    },
    "/studyGroups/{groupId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a study group."
    }
  }
}
